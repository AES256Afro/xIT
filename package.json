{
  "name": "xit",
  "version": "1.3.0",
  "private": true,
  "description": "Chrome and Firefox extension that copies X/Twitter links through a redirector of your choice.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "icons": "node tools/make-icons.mjs",
    "test": "node --test test/*.test.mjs",
    "i18n": "node tools/i18n-sync.mjs",
    "i18n:write": "node tools/i18n-sync.mjs --write",
    "test:browser": "node tools/test-browser.mjs",
    "test:firefox": "node tools/test-firefox.mjs",
    "test:qol": "node tools/test-qol.mjs",
    "prepare-dist": "npm run icons && npm run build",
    "store-assets": "node tools/make-store-assets.mjs"
  },
  "license": "MIT"
}
